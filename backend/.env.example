# ============================================================================
# Romanya Dosya Takip -- Backend Ortam Değişkenleri Örneği
# ============================================================================
# Bu dosyayı ".env" olarak kopyala (aynı klasörde, backend/ içinde) ve
# değerleri kendi bilgilerinle doldur. ".env" dosyası .gitignore'da
# olduğu için git'e hiç gönderilmez -- güvenli.
#
#   cp .env.example .env      (Mac/Linux)
#   copy .env.example .env    (Windows PowerShell/CMD)
#
# HİÇBİRİNİ doldurmasan da sistem çalışmaya devam eder -- sadece o özellik
# (bildirim kanalı / uygulama anahtarı doğrulaması) sessizce devre dışı kalır.
# ============================================================================

# --- Uygulama anahtarı (Faz 1.8 -- kötüye kullanıma karşı basit koruma) ----
# Mobil uygulama her istekte bu değeri "X-App-Key" header'ı olarak gönderir.
# ÖNEMLİ (2026-08-15 güvenlik düzeltmesi): buraya GERÇEK anahtarını YAZMA --
# bu dosya .gitignore'da DEĞİL, yani git'e/GitHub'a gönderilir. Kendi
# anahtarını üretmek için (terminalde, backend/ klasöründeyken):
#   python -c "import secrets; print(secrets.token_hex(24))"
# çıkan değeri SADECE ".env" dosyana yapıştır (o dosya .gitignore'da,
# güvenli). Mobil tarafta da (proje kökünde, backend/ DEĞİL) AYNI değeri
# EXPO_PUBLIC_APP_KEY olarak girmen gerekiyor -- ikisi de UYUŞMALI.
APP_API_KEY=buraya_kendi_urettigin_anahtari_yapistir

# --- Telegram (admin'e kritik uyarılar) ------------------------------------
# 1) Telegram'da @BotFather ile konuş, "/newbot" yaz, adım adım ilerle.
#    Sonunda sana "123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" gibi bir
#    BOT TOKEN verecek -- onu aşağıya yapıştır.
# 2) Kendi chat_id'ni öğrenmek için: Telegram'da @userinfobot'a "/start" yaz,
#    sana ID'ni (sadece rakamlardan oluşan bir sayı) gösterecek.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-posta (admin'e kritik uyarılar) -------------------------------------
# Hotmail/Outlook hesabınla göndermek istersen (ADMIN_EPOSTA'ya da aynısını
# yazabilirsin, kendine gönderip kendin okursun):
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_KULLANICI=ahmet.kanbay@hotmail.com
#   SMTP_SIFRE=<Outlook hesabının UYGULAMA ŞİFRESİ -- normal şifren DEĞİL>
# Uygulama şifresi almak için: Microsoft hesabı -> Güvenlik ->
# "Uygulama şifreleri" (2 adımlı doğrulama açık olmalı).
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_SIFRE=
# Kritik uyarıların gönderileceği adres (senin adresin):
ADMIN_EPOSTA=ahmet.kanbay@hotmail.com
